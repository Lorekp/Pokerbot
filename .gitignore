# cloned external benchmark repos (regenerated by external/clone_benchmarks.sh)
external/benchmarks/

# ---- clean-tree snapshot 2026-07-15: exclude untracked eval scratch / runtime state / backups ----
# NOTE: .gitignore never un-tracks; the ~800 curated artifacts/*.md reports already committed stay tracked.
# This only suppresses the hundreds of untracked eval-run blobs (json/out/pkl/jsonl/pid/shards/subdirs).
# To version a specific new artifact deliberately, use `git add -f <path>`.
artifacts/
# pytest local dependency / wheel / tmp scratch (regenerable, permission-locked)
.pytest_deps_live/
.pytest_deps_local/
.pytest_wheels_live/
.pytest_tmp_live*/
# live arena/player runtime profile state + rotating backups — never commit session state
data/arena_profiles/
data/player_profiles/arena_*.json
data/player_profiles/*.bak
# native build zombie handle + tmp launcher scratch + native example artifacts
battery_native.pyd.zombieheld_*
launcher_HEAD_tmp.py
tools/battery_native/artifacts/
# ad-hoc scratch note (not project docs)
discord_tournament_clock_ticket.txt
# ---- large vendored/regenerable data blobs purged from history 2026-07-15 (kept on disk, never commit) ----
# GitHub rejects >100MB blobs; these were stripped from all commits via git-filter-repo.
data/pokerbench/**/postflop_500k_train_set_prompt_and_label.json
data/pokerbench/**/postflop_500k_train_set_game_scenario_information.csv
data/pokerbench/**/preflop_60k_train_set_prompt_and_label.json
data/aof/cfr_base/trio_eq_tensor.npz
