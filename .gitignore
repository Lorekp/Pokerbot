.env
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/
checkpoints/
eval_results.json
.external/
.venv/
venv/

# transient run outputs / logs (eval metrics live under runs/, can be regenerated)
runs/
logs/
*.log

# native build artifacts (Rust kernel; source under tools/marg3_native/src is versioned)
tools/marg3_native/target/
*.pyd

# scratch / vendored reference checkouts (not part of any shipped project)
_ck/
_ck2/
_ref_poker/
_vendor/
.cursor/
trend.txt
$OUT
*.err
cargo-flamegraph.stacks

# model blobs / scratch artifacts (sourced externally; cf. checkpoints/)
models/
data/_proftest.json
data/aof/cfr_base/tensor_row_checkpoints/

# Large downloaded datasets (IRC poker DB etc.) — never commit
data/datasets/
*.tgz

# CoinPoker client binary snapshots (proprietary, ~41MB each) - kept on disk for post-update diffing, never committed
artifacts/client_snapshot/

# Claude Code tooling state (agent worktrees ~GB, session transcripts) — never commit
.claude/
.ultracode_backup/
# scratch / crash dumps
*.stackdump
bash.exe.stackdump
diag_fix.out
hu_oracle_check.out
err.txt
# Rust build artifacts (regenerable) — source under tools/*/src is versioned
target/
*.rlib
*.rmeta
# large regenerable data / vendored external repos / venvs (keep OUT of git history)
data/validate50/
data/validate50_ec2/
.venv*/
external/AlphaNLHoldem/
external/pokerbench/
external/*/target/
# ---- regenerable native build dirs / profile+checkpoint blobs / frozen tables / flamegraphs ----
target_*/
tools/*/target_*/
*.bin
*.emdfrzn
artifacts/*.svg
data/io_bench_tmp/
artifacts/probe_watch_*.log
_rendered_ud.sh
